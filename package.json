{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite --port=3000 --host=0.0.0.0",
    "build": "vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.js && node scripts/generate-sitemap.js",
    "preview": "vite preview",
    "clean": "rm -rf dist dist-ssr",
    "lint": "tsc --noEmit",
    "studio": "sanity dev",
    "studio:login": "sanity login",
    "studio:deploy": "sanity deploy",
    "studio:build": "sanity build",
    "studio:seed": "sanity dataset import sanity/seed-data.ndjson production --replace"
  },
  "dependencies": {
    "@sanity/client": "^8.9.0",
