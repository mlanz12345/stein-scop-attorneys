    "@vercel/speed-insights": "^2.0.0",
    "@vitejs/plugin-react": "^5.0.4",
    "clsx": "^2.1.1",
    "dotenv": "^17.2.3",
    "hls.js": "^1.6.16",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "react-helmet-async": "^3.0.0",
    "react-router-dom": "^7.14.2",
    "sanity-plugin-media": "^6.3.5",
    "tailwind-merge": "^3.5.0",
    "vercel": "^63.1.2",
